            ],
            "matchMode": "any"
          }
        }
      },
      "actions": {
        "log": {
          "enabled": true,
          "fileName": "crimes"
        },
        "discord": [
          {
            "id": "crime_public",
            "webhook": "https://discord.com/api/webhooks/YOUR_PUBLIC_WEBHOOK_ID/YOUR_PUBLIC_WEBHOOK_TOKEN",
            "webhookType": "public",
            "message": "🚨 [[displayName]] a commis un crime !"
          },
          {
            "id": "crime_admin",
            "webhook": "https://discord.com/api/webhooks/YOUR_ADMIN_WEBHOOK_ID/YOUR_ADMIN_WEBHOOK_TOKEN",
            "webhookType": "admin",
            "message": "**[[fullIdentity]]** a commis un crime\nSteamID: `[[steamId]]`\nDétails: [[params]]"
          },
          {
            "id": "crime_watched_alert",
            "webhook": "https://discord.com/api/webhooks/YOUR_ALERT_WEBHOOK_ID/YOUR_ALERT_WEBHOOK_TOKEN",
            "webhookType": "admin",
            "message": "@here 🚨 **ENTITÉ SURVEILLÉE**\n**Perso:** [[charName]]\n**Alias:** [[actName]]\n**Steam:** [[steamId]]\n**Crime:** [[params]]",
            "allowMentions": true,
            "conditions": {
              "watchedEntity": {
                "anyOf": [
                  "watch_foo"
                ]
              }
            }
          }
        ]
      }
    },
