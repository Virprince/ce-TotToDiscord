  "watchedEntities": [
    {
      "id": "example_player",
      "name": "Exemple Joueur",
      "enabled": true,
      "matchType": "steamId",
      "value": "76561198000000000",
      "description": "Exemple d'entité surveillée"
    }
  ],
  "rules": [
    {
      "id": "crime_tracking",
      "name": "Suivi des crimes",
      "enabled": true,
      "priority": 20,
      "stopPropagation": false,
      "conditions": {
        "eventId": "FlowChartLog",
        "parsed": {
          "tags": {
            "contains": ["CRIME"],
            "matchMode": "any"
          }
        }
      },
      "actions": {
        "log": {
          "enabled": true,
          "fileName": "crimes"
        },
        "discord": [
          {
            "id": "crime_public",
