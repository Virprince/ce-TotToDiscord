            "message": "🚨 [[displayName]] a commis un crime !"
          },
          {
            "id": "crime_admin",
            "webhook": "https://discord.com/api/webhooks/YOUR_ADMIN_WEBHOOK_URL_HERE",
            "webhookType": "admin",
            "message": "🚨 **Crime détecté**\n👤 **Joueur**: [[fullIdentity]]\n📋 **Détails**: [[params]]"
          }
        ]
      }
    }
  ]
